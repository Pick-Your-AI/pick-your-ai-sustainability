{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pick Your AI opportunity evidence register",
  "type": "object",
  "required": [
    "schema_version",
    "last_verified",
    "records_count",
    "records",
    "important_limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "sustainability-opportunity-register/v1"
    },
    "last_verified": {
      "type": "string",
      "format": "date"
    },
    "records_count": {
      "type": "integer",
      "minimum": 0
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "opportunity_id",
          "provider",
          "program_name",
          "owning_research_key",
          "official_program_url",
          "official_application_url",
          "source_urls",
          "last_verified",
          "available_before_incorporation",
          "available_through_fiscal_sponsorship",
          "available_after_501c3_recognition",
          "eligibility_status",
          "application_gate",
          "source_review_status",
          "scoring",
          "priority",
          "linked_github_research_issue"
        ],
        "properties": {
          "opportunity_id": {
            "type": "string",
            "minLength": 1
          },
          "owning_research_key": {
            "type": "string",
            "pattern": "^E[0-9]{2}-[0-9]{2}[A-Z]?$"
          },
          "official_program_url": {
            "type": "string",
            "format": "uri"
          },
          "official_application_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "linked_github_research_issue": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "estimated_usable_value": {
            "type": [
              "number",
              "null"
            ]
          },
          "score": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "source_urls": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "scoring": {
            "type": "object",
            "required": [
              "mission_fit",
              "eligibility",
              "net_usable_value",
              "likelihood_evidence",
              "timing",
              "effort",
              "independence_risk",
              "strategic_value",
              "total",
              "justification"
            ],
            "properties": {
              "mission_fit": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 5
              },
              "eligibility": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 5
              },
              "net_usable_value": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 5
              },
              "likelihood_evidence": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 5
              },
              "timing": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 5
              },
              "effort": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 5
              },
              "independence_risk": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 5
              },
              "strategic_value": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 5
              },
              "total": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100
              },
              "justification": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "source_review_status": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "program_name": {
            "type": "string",
            "minLength": 1
          },
          "available_before_incorporation": {
            "type": "string",
            "minLength": 1
          },
          "available_through_fiscal_sponsorship": {
            "type": "string",
            "minLength": 1
          },
          "available_after_501c3_recognition": {
            "type": "string",
            "minLength": 1
          },
          "eligibility_status": {
            "type": "string",
            "minLength": 1
          },
          "application_gate": {
            "type": "string",
            "minLength": 1
          },
          "last_verified": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "application_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          }
        }
      }
    },
    "important_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
